#!/bin/sh

os=$(uname -s)
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
tempfile=$(mktemp -t qr-XXXXXX)

capture() {
    case "$os" in
        Darwin)
            screencapture -i "$1"
            ;;
        *)
            if [ -n "$WAYLAND_DISPLAY" ] && \
               command -v grim >/dev/null 2>&1 && \
               command -v slurp >/dev/null 2>&1; then
                grim -g "$(slurp)" "$1"
            else
                maim -soBu --color=0.8,0.8,0.8,0.6 "$1"
            fi
            ;;
    esac
}

clip() {
    case "$os" in
        Darwin)
            pbcopy
            ;;
        *)
            if [ -n "$WAYLAND_DISPLAY" ] && \
               command -v wl-copy >/dev/null 2>&1; then
                wl-copy
            else
                xclip -selection c
            fi
            ;;
    esac
}

decode() {
    case "$os" in
        Darwin)
            swift "$here/qrdecode.swift" "$1"
            ;;
        *)
            zbarimg --quiet --raw "$1"
            ;;
    esac
}

if capture "$tempfile"; then
    scanresult=$(decode "$tempfile" | tr -d '\n')

    if [ -z "$scanresult" ]; then
        "$here/notify" "QR Scan" "No scan data found!"
    else
        printf '%s' "$scanresult" | clip
        "$here/notify" -i "$tempfile" "QR Scan" \
            "$scanresult\nCopied to clipboard."
    fi
fi

rm "$tempfile"
