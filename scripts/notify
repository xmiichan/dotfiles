#!/usr/bin/env sh

notify() {
    icon=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -i) icon="$2"; shift 2 ;;
            -i*) icon="${1#-i}"; shift ;;
            --) shift; break ;;
            *) break ;;
        esac
    done

    if [ "$#" -ge 2 ]; then
        title="${1:-}"
        message="${2:-}"
    else
        title="Notification"
        message="${1:-}"
    fi

    message=$(printf '%b' "$message")

    case "$(uname -s)" in
        Darwin)
            osascript - "$title" "$message" <<'END'
on run argv
    display notification (item 2 of argv) with title (item 1 of argv)
end run
END
            ;;
        Linux)
            if command -v notify-send >/dev/null 2>&1; then
                if [ -n "$icon" ]; then
                    notify-send -i "$icon" "$title" "$message"
                else
                    notify-send "$title" "$message"
                fi
            else
                printf '%s: %s\n' "$title" "$message" >&2
            fi
            ;;
        *)
            printf '%s: %s\n' "$title" "$message" >&2
            ;;
    esac
}

notify "$@"
