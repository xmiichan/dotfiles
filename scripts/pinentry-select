#!/bin/sh

if [ "$(uname)" = Darwin ]; then
    gui='pinentry-mac'
else
    gui='pinentry-gnome3 pinentry-qt pinentry-gtk-2 pinentry-bemenu'
    [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ] || gui=''
fi

for p in $gui; do
    command -v "$p" >/dev/null 2>&1 && exec "$p" "$@"
done

for p in pinentry-curses pinentry-tty pinentry; do
    command -v "$p" >/dev/null 2>&1 && exec "$p" "$@"
done

exit 1
