{{- $personal := promptBoolOnce . "personal" "Personal machine" -}}
{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $gitEmail := promptStringOnce . "gitEmail" "Email address used for git" -}}
{{- $gitName := promptStringOnce . "gitName" "Name used for git" -}}

encryption = "age"
sourceDir = "~/.dotfiles"
mode = "symlink"

[age]
    identity = "~/.config/chezmoi/key.txt"
    recipient = "age1ta5haf4t3nm3xhve5eq5x7uxzjkr7q88w7andnx6etwlmaa7xeqqzf6nqg"

[data]
    personal = {{ $personal }}
    email = {{ $email | quote }}
    gitEmail = {{ $gitEmail | quote }}
    gitName = {{ $gitName | quote }}
