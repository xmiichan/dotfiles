" highlight yanked text
augroup highlight_yank
    autocmd!
    autocmd TextYankPost * call s:HighlightYank()
augroup END
function! s:HighlightYank()
    let l:start = getpos("'[")
    let l:end = getpos("']")
    if l:start[1] == l:end[1]
        let l:match = matchaddpos('IncSearch', [[l:start[1], l:start[2], l:end[2] - l:start[2] + 1]])
    else
        let l:lines = []
        for l:lnum in range(l:start[1], l:end[1])
            call add(l:lines, [l:lnum])
        endfor
        let l:match = matchaddpos('IncSearch', l:lines)
    endif
    call timer_start(200, {-> matchdelete(l:match)})
endfunction

" replace operator (s to replace without yanking)
function! s:Replace(type, ...) abort
    let l:sel_save = &selection
    let &selection = 'inclusive'
    if a:0
        silent exe 'normal! gv"_c' . getreg('"')
    elseif a:type == 'line'
        silent exe "normal! '[V']\"_c" . getreg('"')
    else
        silent exe 'normal! `[v`]"_c' . getreg('"')
    endif
    let &selection = l:sel_save
endfunction

nmap <silent> s :set opfunc=<SID>Replace<cr>g@
nmap <silent> ss :set opfunc=<SID>Replace<cr>g@_
nmap <silent> S s$
xmap <silent> s :<C-u>call <SID>Replace(visualmode(), 1)<cr>
