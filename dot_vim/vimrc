" fugitive
function! s:FugitiveResolve() abort
    let l:dir = fnamemodify(resolve(expand('%:p')), ':h')
    let l:git_dir = trim(system('git -C ' . shellescape(l:dir)
        \ . ' rev-parse --absolute-git-dir 2>/dev/null'))
    if !v:shell_error && !empty(l:git_dir)
        let b:git_dir = l:git_dir
    endif
endfunction
nnoremap <silent> <leader>gg :call <SID>FugitiveResolve()<bar>Git<cr>
nnoremap <silent> <leader>gb :call <SID>FugitiveResolve()<bar>Git blame<cr>
