" strip autowrap in diffs
function! s:DiffNoAutoformat() abort
    for l:win in range(1, winnr('$'))
        if getwinvar(l:win, '&diff')
            let l:buf = winbufnr(l:win)
            let l:fo = getbufvar(l:buf, '&formatoptions')
            call setbufvar(l:buf, '&formatoptions',
                \ substitute(l:fo, '[at]', '', 'g'))
        endif
    endfor
endfunction
if exists('##DiffUpdated')
    augroup diff_no_autoformat
        autocmd!
        autocmd DiffUpdated * call s:DiffNoAutoformat()
    augroup END
endif

" filetype settings
function! s:Prose() abort
    setlocal textwidth=80 formatoptions+=ta spell complete+=kspell
    if exists('+autocomplete')
        setlocal noautocomplete
    endif
    for l:ch in ['.', '!', '?', ',', ';', ':']
        execute 'inoremap <buffer> ' . l:ch . ' ' . l:ch . '<C-g>u'
    endfor
endfunction
augroup filetype_settings
    autocmd!
    autocmd FileType markdown,text call s:Prose()
    autocmd FileType markdown setlocal conceallevel=2
    autocmd FileType mail setlocal textwidth=72 formatoptions+=w
        \ formatoptions-=t nojoinspaces
augroup END

" highlight yanked text
augroup highlight_yank
    autocmd!
    autocmd TextYankPost * call s:HighlightYank()
augroup END
function! s:HighlightYank()
    let l:start = getpos("'[")
    let l:end = getpos("']")
    if l:start[1] == l:end[1]
        let l:match = matchaddpos('IncSearch', [[l:start[1], l:start[2], l:end[2] - l:start[2] + 1]])
    else
        let l:lines = []
        for l:lnum in range(l:start[1], l:end[1])
            call add(l:lines, [l:lnum])
        endfor
        let l:match = matchaddpos('IncSearch', l:lines)
    endif
    call timer_start(200, {-> matchdelete(l:match)})
endfunction

