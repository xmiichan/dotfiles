" marker folds where a file has markers, indent folds elsewhere
function! s:FoldMethod() abort
    if !&diff && empty(&buftype)
        let &l:foldmethod = search('{\{3}', 'nw') ? 'marker' : 'indent'
    endif
endfunction
augroup foldmethod
    autocmd!
    autocmd BufWinEnter * call s:FoldMethod()
augroup END

" modelinestrict ignores foldlevel in modelines, so apply it from here
if exists('+modelinestrict')
    function! s:ModelineFoldLevel() abort
        if !&modeline || !&modelinestrict || &diff || !empty(&buftype)
            return
        endif

        let l:last = line('$')
        let l:lines = getline(1, &modelines) + getline(max([1, l:last - &modelines + 1]), l:last)
        for l:text in l:lines
            let l:level = matchstr(l:text, '\<vim\?:.*\<\%(foldlevel\|fdl\)=\zs\d\+')
            if l:level !=# ''
                let &l:foldlevel = str2nr(l:level)
                return
            endif
        endfor
    endfunction

    augroup modeline_foldlevel
        autocmd!
        autocmd BufWinEnter * call s:ModelineFoldLevel()
    augroup END
endif

