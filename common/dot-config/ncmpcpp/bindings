def_key "j"
  scroll_down
def_key "k"
  scroll_up
def_key "h"
  previous_column
def_key "l"
  next_column
def_key "ctrl-u"
  page_up
def_key "ctrl-d"
  page_down
def_key "g"
  move_home
def_key "G"
  move_end
def_key "d"
  delete_playlist_items
def_key "n"
  next_found_item
def_key "N"
  previous_found_item
def_key "0"
  replay_song
def_key "ctrl-o"
    run_external_console_command "mpc listall | fzf -m --no-sort --exact -d '\t' --bind 'alt-a:select-all,alt-d:deselect-all' | mpc add"
