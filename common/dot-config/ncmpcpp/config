#
# ncmpcpp config
#

mpd_music_dir = "$HOME/Music/Artists"

# Visualizer
visualizer_data_source = "/tmp/mpd.fifo"
visualizer_output_name = "fifo"
visualizer_type = "spectrum" (spectrum/wave)

# Playlist
song_columns_list_format = "(3f)[9]{n: } (40)[default]{t|f:Title} (30)[cyan]{a} (30)[blue]{b} (6f)[magenta]{lr}"
now_playing_prefix = "$(blue)$b"
now_playing_suffix = "$/b$(end)"
playlist_display_mode = "columns" (classic/columns)
autocenter_mode = "no"
centered_cursor = "no"
cyclic_scrolling = "no"
mouse_list_scroll_whole_page = "no"
song_list_format = "$1$9%l$1$9 $1¦$9 $2%a$9 $1¦$9 $5%b$9 $R$1$9%t$1$9 $1¦$9 $1%n$9"
song_library_format = "{%n }{%t}|{%f}"
empty_tag_marker = ""

# Bars
song_status_format = "{%a - }{%t}{ [%b]}|{%f}"
progressbar_look = "─▮─"
titles_visibility = "yes"
header_visibility = "yes"
statusbar_visibility = "yes"

# Browser
browser_playlist_prefix = "$2plist »$9 "
browser_display_mode = "columns"
screen_switcher_mode = "playlist, media_library"
media_library_primary_tag = "album_artist"

# Colors
discard_colors_if_item_is_selected = "yes"
current_item_prefix = "$(blue_235)$b"
current_item_suffix = "$/b$(end)"
current_item_inactive_column_prefix = "$(blue_black)$b"
current_item_inactive_column_suffix = "$/b$(end)"
header_window_color = "black"
volume_color = "green"
state_line_color = "9"
state_flags_color = "red"
main_window_color = "default"
color1 = "default"
color2 = "blue"
progressbar_color = "9"
progressbar_elapsed_color = "blue"
statusbar_color = "white"
statusbar_time_color = "blue"
visualizer_color = "blue,magenta,red"

# Others
song_window_title_format = "MPD: {%a - }{%t}{ [%b]}|{%f}"
search_engine_display_mode = "columns" (classic/columns)
follow_now_playing_lyrics = "yes"
show_duplicate_tags = "no"

