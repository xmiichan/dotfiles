plugins {
    compact-bar location="zellij:compact-bar" {
        tooltip "Ctrl ?"
    }
}

load_plugins {
    compact-bar
}

keybinds clear-defaults=true {
    tmux {
        bind "Ctrl Space" { SwitchToMode "normal"; }
        bind "p" { SwitchToMode "pane"; }
        bind "t" { SwitchToMode "tab"; }
        bind "l" { SwitchToMode "locked"; }
        bind "o" { SwitchToMode "session"; }
        bind "Space" { SwitchToMode "scroll"; }
        bind "Ctrl s" "/" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "f" {
            LaunchOrFocusPlugin "filepicker" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "normal"
        }
        bind "s" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "normal"
        }
    }
    locked {
        bind "Ctrl Alt l" { SwitchToMode "normal"; }
    }
    shared_except "locked" "normal" {
        bind "Esc" { SwitchToMode "normal"; }
    }
    normal {
        unbind "Esc"
        bind "Ctrl Space" { SwitchToMode "tmux"; }
        bind "Alt h" "Alt Left" { MoveFocus "Left"; }
        bind "Alt j" "Alt Down" { MoveFocus "Down"; }
        bind "Alt k" "Alt Up" { MoveFocus "Up"; }
        bind "Alt l" "Alt Right" { MoveFocus "Right"; }
        bind "Alt H" "Alt Shift Left" { Resize "Increase Left"; }   
        bind "Alt J" "Alt Shift Down" { Resize "Increase Down"; }   
        bind "Alt K" "Alt Shift Up" { Resize "Increase Up"; }     
        bind "Alt L" "Alt Shift Right" { Resize "Increase Right"; } 
        bind "Ctrl Alt h" "Ctrl Alt Left" { MovePane "Left"; }   
        bind "Ctrl Alt j" "Ctrl Alt Down" { MovePane "Down"; }   
        bind "Ctrl Alt k" "Ctrl Alt Up" { MovePane "Up"; }       
        bind "Ctrl Alt l" "Ctrl Alt Right" { MovePane "Right"; } 
        bind "Alt Enter" { NewPane; }
        bind "Alt Shift Enter" { NewPane "stacked"; }
        bind "Alt f" { ToggleFloatingPanes; }
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        bind "Alt t" { NewTab; }
        bind "Alt p" { GoToPreviousTab; }
        bind "Alt n" { GoToNextTab; }
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
        bind "Alt Tab" { ToggleTab; }
    }
    pane {
        bind "c" { NewPane; SwitchToMode "normal"; }
        bind "s" { NewPane "Down"; SwitchToMode "normal"; }
        bind "v" { NewPane "Right"; SwitchToMode "normal"; }
        bind "S" { NewPane "stacked"; SwitchToMode "normal"; }
        bind "x" { CloseFocus; SwitchToMode "normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "normal"; }
        bind "b" { TogglePaneFrames; SwitchToMode "normal"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "normal"; }
        bind "r" { SwitchToMode "RenamePane"; PaneNameInput 0;}
        bind "i" { TogglePanePinned; SwitchToMode "normal"; }
    }
    tab {
        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "c" { NewTab; SwitchToMode "normal"; }
        bind "x" { CloseTab; SwitchToMode "normal"; }
        bind "s" { ToggleActiveSyncTab; SwitchToMode "normal"; }
        bind "b" { BreakPane; SwitchToMode "normal"; }
        bind "]" { BreakPaneRight; SwitchToMode "normal"; }
        bind "[" { BreakPaneLeft; SwitchToMode "normal"; }
    }
    renametab {
        bind "Enter" { SwitchToMode "normal"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "tab"; }
    }
    renamepane {
        bind "Enter" { SwitchToMode "normal"; }
        bind "Esc" { UndoRenamePane; SwitchToMode "tab"; }
    }
    scroll {
        bind "e" { EditScrollback; SwitchToMode "normal"; }
        bind "Ctrl s" "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
        bind "Ctrl b" "PageUp" "Left" "h" { PageScrollUp; }
        bind "Ctrl d" "d" "Ctrl v" { HalfPageScrollDown; }
        bind "Ctrl u" "u" "Alt v" { HalfPageScrollUp; }
    }
    search {
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
        bind "Ctrl b" "PageUp" "Left" "h" { PageScrollUp; }
        bind "Ctrl d" "d" { HalfPageScrollDown; }
        bind "Ctrl u" "u" { HalfPageScrollUp; }
        bind "Ctrl s" "n" { Search "down"; }
        bind "Ctrl r" "p" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }
    entersearch {
        bind "Ctrl c" "Esc" { SwitchToMode "scroll"; }
        bind "Enter" { SwitchToMode "search"; }
    }
    session {
        bind "q" { Quit; }
        bind "d" { Detach; }
        bind "p" {
            LaunchOrFocusPlugin "plugin-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "normal"
        }
        bind "x" {
            LaunchOrFocusPlugin "zellij:share" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "normal"
        }
        bind "l" {
            LaunchOrFocusPlugin "zellij:layout-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "normal"
        }
    }
}

default_mode "normal"
default_layout "mine"
simplified_ui true

pane_frames true
advanced_mouse_actions false
scroll_buffer_size 50000
copy_on_select true
theme "catppuccin-mocha"
show_startup_tips false
