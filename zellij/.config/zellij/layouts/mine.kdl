layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm" {
                format_left   "{mode} #[fg=blue,bold]{session} #[]{tabs}"
                format_center "{notifications}"
                format_right  "{command_git_branch} {datetime}"
                format_space  ""

                tooltip_enabled true
                tooltip_delay   250

                hide_frame_for_single_pane true

                mode_normal  "#[bg=blue] "
                mode_tmux    "#[bg=yellow] "
                mode_locked  "#[bg=red] "

                tab_normal   " #[fg=black,bold]{name}{sync_indicator}{fullscreen_indicator} "
                tab_active   " #[fg=green,bold]{name}{sync_indicator}{fullscreen_indicator} "

                command_git_branch_command     "git rev-parse --abbrev-ref HEAD"
                command_git_branch_format      "#[fg=green] {stdout} "
                command_git_branch_interval    "5"
                command_git_branch_rendermode  "dynamic"

                tab_sync_indicator       ">"
                tab_fullscreen_indicator "*"

                datetime        "#[fg=brightblack] {format} "
                datetime_format "%a, %b %d  %H:%M"
                datetime_timezone "Europe/Berlin"
            }
        }
        children
    }
}
