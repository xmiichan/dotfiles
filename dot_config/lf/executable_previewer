#!/usr/bin/env sh
case "$(file -Lb --mime-type -- "$1")" in
  image/*)
    chafa -f sixel -s "$(($2-2))x$3" --animate off --polite on -t 1 "$1"
    ;;
  video/*)
    thumb="/tmp/lfthumb.png"
    ffmpegthumbnailer -i "$1" -o "$thumb" -s 0
    chafa -f sixels -s "$(($2-2))x$3" --animate off --polite on -t 1 "$thumb"
    ;;
  text/*)
    cat -v "$1"
    ;;
esac
