set modeindicatormodes.normal false
set hintfiltermode vimperator-reflow
colourscheme --module=reader serif

bind J tabnext
bind K tabprev
bind ' gobble 1 markjump
unbind --mode=hint <Space>

" disabled nested hinting
bind f hint -Jc a,area,button,input:not([type=hidden]),select,textarea,summary,label,[onclick],[role=button],[role=link],[role=tab],[role=menuitem],[role=checkbox],.expando-button -x a>[role=link],div.thing
bind F hint -Jbc a,area,button,input:not([type=hidden]),select,textarea,summary,label,[onclick],[role=button],[role=link],[role=tab],[role=menuitem],[role=checkbox],.expando-button -x a>[role=link],div.thing
bind ;f hint
bind ;F hint -b

bind go js const h = location.hostname, p = h.split("."), d = p[Math.max(p.length - 2, 0)], u = "open " + location.href, s = u.indexOf(h) + h.length - p.slice(-2).join(".").length; tri.excmds.fillcmdline_notrail(u).then(() => document.getElementById("cmdline_iframe").contentWindow.document.getElementById("tridactyl-input").setSelectionRange(s, s + d.length));

bindurl youtube.com <C-j> js \
    let s = document.createElement('script'); \
    s.textContent = 'document.querySelector("#movie_player").seekBy(-10)'; \
    document.head.appendChild(s); \
    s.remove()
bindurl youtube.com <C-l> js \
    let s = document.createElement('script'); \
    s.textContent = 'document.querySelector("#movie_player").seekBy(+10)'; \
    document.head.appendChild(s); \
    s.remove()
bindurl ^https?://duckduckgo\.com gi focusinput #searchbox_input

autocontain -s google\.(com?\.)?[a-z]{2,3} Google
autocontain -s youtube\.com Google
autocontain -s youtu\.be Google

" vim: set filetype=tridactyl:
