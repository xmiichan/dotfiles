#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    theme: Some("mii"),
    scrolloff: 2,
    wrap_navigation: true,
    ignore_leading_the: true,
    album_art: (
        horizontal_align: Center,
        vertical_align: Center,
    ),
    keybinds: (
        global: {
            "u": Update,
            "U": Rescan,
            "H": PreviousTab,
            "L": NextTab,
        },
    ),
    cava: (
        framerate: 60,
        input: (
            method: Fifo,
            source: "/tmp/mpd.fifo",
        ),
        smoothing: (
            noise_reduction: 77,
        ),
    ),
    artists: (
            album_display_mode: NameOnly,
            album_sort_by: Date,
            album_date_tags: [OriginalDate, Date],
            ),
    tabs: [
        (
            name: "Queue",
            pane: Split(
                direction: Vertical,
                panes: [
                    (
                        size: "3",
                        borders: "ALL",
                        border_symbols: Inherited(parent: Rounded, bottom_left: "├", bottom_right: "┤",),
                        pane: Split(
                            direction: Horizontal,
                            panes: [
                                (size: "1", pane: Pane(Empty())),
                                (size: "100%", pane: Pane(QueueHeader())),
                            ]
                        )
                    ),
                    (
                        size: "100%",
                        borders: "LEFT | RIGHT | BOTTOM",
                        border_symbols: Inherited(parent: Rounded),
                        pane: Split(
                            direction: Horizontal,
                            panes: [
                                (size: "1", pane: Pane(Empty())),
                                (size: "100%", pane: Pane(Queue)),
                            ]
                        )
                    ),
                ],
            ),
        ),
        (
            name: "Artists",
            pane: Split(
                direction: Vertical,
                panes: [
                    (
                        size: "100%",
                        borders: "ALL",
                        border_symbols: Rounded,
                        pane: Pane(AlbumArtists),
                    ),
                ]
            ),
        ),
        (
            name: "Albums",
            pane: Split(
                direction: Vertical,
                panes: [
                    (
                        size: "100%",
                        borders: "ALL",
                        border_symbols: Rounded,
                        pane: Pane(Albums),
                    ),
                ]
            ),
        ),
        (
            name: "Playlists",
            pane: Split(
                direction: Vertical,
                panes: [
                    (
                        size: "100%",
                        borders: "ALL",
                        border_symbols: Rounded,
                        pane: Pane(Playlists),
                    ),
                ]
            ),
        ),
        (
            name: "Files",
            pane: Split(
                direction: Vertical,
                panes: [
                    (
                        size: "100%",
                        borders: "ALL",
                        border_symbols: Rounded,
                        pane: Pane(Directories),
                    ),
                ]
            ),
        ),
        (
            name: "Search",
            pane: Split(
                direction: Vertical,
                panes: [
                    (
                        size: "100%",
                        borders: "ALL",
                        border_symbols: Rounded,
                        pane: Pane(Search),
                    ),
                ]
            ),
        ),
    ],
)
