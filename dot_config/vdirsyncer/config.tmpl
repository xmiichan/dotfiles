[general]
status_path = "~/.local/share/vdirsyncer/status/"

[pair posteo_calendar]
a = "calendar_local"
b = "calendar_remote"
collections = ["from a", "from b"]
conflict_resolution = "b wins"
metadata = ["displayname", "color"]

[storage calendar_local]
type = "filesystem"
path = "~/.local/share/calendars/"
fileext = ".ics"

[storage calendar_remote]
type = "caldav"
url = "https://posteo.de:8443/"
username = {{ .email | quote }}
password.fetch = ["shell", {{ if eq .chezmoi.os "darwin" }}"security find-generic-password -s mail-sync -w 2>/dev/null || gpg -dq --no-tty $HOME/.dotfiles/secrets/smtp-pass.gpg"{{ else }}"gpg -dq --no-tty $HOME/.dotfiles/secrets/smtp-pass.gpg"{{ end }}]

[pair posteo_contacts]
a = "contacts_local"
b = "contacts_remote"
collections = ["from a", "from b"]
conflict_resolution = "b wins"

[storage contacts_local]
type = "filesystem"
path = "~/.local/share/contacts/"
fileext = ".vcf"

[storage contacts_remote]
type = "carddav"
url = "https://posteo.de:8843/"
username = {{ .email | quote }}
password.fetch = ["shell", {{ if eq .chezmoi.os "darwin" }}"security find-generic-password -s mail-sync -w 2>/dev/null || gpg -dq --no-tty $HOME/.dotfiles/secrets/smtp-pass.gpg"{{ else }}"gpg -dq --no-tty $HOME/.dotfiles/secrets/smtp-pass.gpg"{{ end }}]

