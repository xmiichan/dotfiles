highlight clear

highlight Win        cterm=none ctermfg=default    ctermbg=default
highlight Directory  cterm=none ctermfg=blue       ctermbg=default
highlight Link       cterm=none ctermfg=magenta    ctermbg=default
highlight BrokenLink cterm=bold ctermfg=red        ctermbg=default
highlight Executable cterm=none ctermfg=red        ctermbg=default
highlight Socket     cterm=none ctermfg=green      ctermbg=default
highlight Device     cterm=none ctermfg=blue       ctermbg=default
highlight Fifo       cterm=none ctermfg=yellow     ctermbg=default
highlight Selected   cterm=bold ctermfg=yellow     ctermbg=black
highlight CurrLine   cterm=bold ctermfg=default    ctermbg=lightblack
highlight OtherLine  cterm=none ctermfg=default    ctermbg=black
highlight LineNr     cterm=none ctermfg=lightblack ctermbg=default
highlight Border     cterm=none ctermfg=lightblack ctermbg=default
highlight TopLine    cterm=none ctermfg=white      ctermbg=default
highlight TopLineSel cterm=bold ctermfg=yellow     ctermbg=default
highlight TabLine    cterm=none ctermfg=white      ctermbg=default
highlight TabLineSel cterm=bold ctermfg=yellow     ctermbg=default
highlight StatusLine cterm=none ctermfg=white      ctermbg=black
highlight CmdLine    cterm=none ctermfg=default    ctermbg=default
highlight ErrorMsg   cterm=bold ctermfg=red        ctermbg=default
highlight WildBox    cterm=none ctermfg=default    ctermbg=black
highlight WildMenu   cterm=bold ctermfg=black      ctermbg=yellow
highlight SuggestBox cterm=none ctermfg=default    ctermbg=black
highlight JobLine    cterm=none ctermfg=yellow     ctermbg=black
