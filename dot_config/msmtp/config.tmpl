account default
host posteo.de
port 465
auth on
tls on
tls_starttls off
tls_certcheck off
user {{ .email | quote }}
passwordeval {{ if eq .chezmoi.os "darwin" }}"security find-generic-password -s mail-sync -w 2>/dev/null || gpg -d -q --for-your-eyes-only --no-tty $DOTFILES/secrets/smtp-pass.gpg"{{ else }}"gpg -d -q --for-your-eyes-only --no-tty $DOTFILES/secrets/smtp-pass.gpg"{{ end }}
logfile "~/.cache/msmtp/msmtp.log"

# vim: set filetype=conf:
