#!/bin/sh

{{- if eq .chezmoi.os "darwin" }}
profiles="{{ .chezmoi.homeDir }}/Library/Application Support/Firefox/Profiles"
{{- else }}
profiles="{{ .chezmoi.homeDir }}/.mozilla/firefox"
{{- end }}
for profile in "$profiles"/*; do
    [ -f "$profile/prefs.js" ] || continue
    ln -sf "{{ .chezmoi.sourceDir }}/firefox/user.js" "$profile/user.js"
done
