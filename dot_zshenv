#!/usr/bin/env zsh

# Environment variables
export LANG='en_US.UTF-8'
export XKB_DEFAULT_LAYOUT="eu"
export XKB_DEFAULT_OPTIONS="caps:ctrl_modifier"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-$TMPDIR}"
export QT_QPA_PLATFORMTHEME=qt5ct
export DOTFILES="$HOME/.dotfiles"
export LESS="-R"
export PAGER="less -R"
export MANPAGER="less -R --use-color -Dd+g -Du+y -Ds+r"
export EDITOR=vi
export LYNX_CFG="$XDG_CONFIG_HOME/lynx/lynx.cfg"
export LYNX_LSS="$XDG_CONFIG_HOME/lynx/lynx.lss"
export MDCAT_THEME=catppuccin-mocha
export _Z_DATA="$XDG_DATA_HOME/z"
export FZF_DEFAULT_OPTS=" \
--color=bg+:#313244,spinner:#F5E0DC,hl:#F38BA8 \
--color=fg:#CDD6F4,header:#F38BA8,info:#CBA6F7,pointer:#F5E0DC \
--color=marker:#B4BEFE,fg+:#CDD6F4,prompt:#CBA6F7,hl+:#F38BA8 \
--color=selected-bg:#45475A \
--color=border:#6C7086,label:#CDD6F4"

[[ -S "$XDG_RUNTIME_DIR/ssh-agent.socket" ]] &&
      export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"

# Perl
PERLDIR="$HOME/.local/perl5"
PERL5LIB="$PERLDIR/lib/perl5${PERL5LIB:+:${PERL5LIB}}"
export PERL5LIB
PERL_LOCAL_LIB_ROOT="$PERLDIR${PERL_LOCAL_LIB_ROOT:+:${PERL_LOCAL_LIB_ROOT}}"
export PERL_LOCAL_LIB_ROOT
PERL_MB_OPT="--install_base \"$PERLDIR\""
export PERL_MB_OPT
PERL_MM_OPT="INSTALL_BASE=$PERLDIR"
export PERL_MM_OPT

# PATH
typeset -gU cdpath fpath mailpath path

## make sure brew is in PATH on MacOS
if [ -f "/opt/homebrew/bin/brew" ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

typeset -ga MY_PATH_DIRS=(
    "$DOTFILES/scripts"
    "$HOME/.local/bin"
    "$HOME/.cargo/bin"
    "$HOME/.roswell/bin"
    "$PERLDIR/bin"
    "/Library/TeX/texbin"
)
for p in $MY_PATH_DIRS; do
    [ -d "$p" ] && path+=("$p")
done
unset MY_PATH_DIRS

if (( $+commands[vim] )); then
    export EDITOR=vim
fi
