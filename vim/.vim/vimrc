    hi link LspErrorVirtualText LspErrorText
    hi LspErrorHighlight cterm=undercurl ctermul=Red
    hi LspWarningText ctermfg=Yellow
    hi link LspWarningVirtualText LspWarningText
    hi LspWarningHighlight cterm=undercurl ctermul=Yellow
    hi LspInformationText ctermfg=Blue
    hi link LspInformationVirtualText LspInformationText
