" BASIC CONFIG
if &compatible
    set nocompatible
endif

set backspace=2         " backspace in insert mode works like normal editor
syntax on               " syntax highlighting
filetype indent on      " activates indenting for files
set autoindent          " auto indenting
set smartindent         " smart indenting
set ignorecase          " case-insensitive search
set smartcase           " ... unless you're explicit
set smarttab            " smart tabbing and deleting indentation
set wrap                " line wrap
set hidden              " allow hiding unsaved buffers
set number              " line numbers
set nobackup            " get rid of anoying ~files
set autoread            " automatically reload files that have been changed
set hlsearch            " highlight search results
set ruler               " show current position
set showmatch           " show matching parens etc.
set encoding=utf8       " set unicode as standard encoding
set autochdir           " cwd follows file
set shiftwidth=4        " indent by 4 spaces
set tabstop=4           " tab = 4 spaces
set laststatus=2        " mode line
set colorcolumn=80      " line at 80 ch width
set splitbelow          " new split obens below
set splitright          " new split obens right
set cursorline          " cursor line
set wildmenu            " menu autocomplete
set mouse=a             " mouse support
set relativenumber      " relative line numbers
set re=0                " don't use old regex engine
set scrolloff=8         " keep 8 lines while scrolling
set updatetime=100      " update every 100ms
set ttimeoutlen=50      " quicker exit insert mode with esc

" saving options in session and view files causes more problems than it solves
set sessionoptions-=options
set viewoptions-=options

" undercurl support
let &t_Cs = "\e[4:3m"
let &t_Ce = "\e[4:0m"

" bar cursor in insert mode
let &t_SI = "\e[6 q"
let &t_EI = "\e[2 q"

" undo
if has('persistent_undo')
    set undofile undodir=$HOME/.cache/vim/undo
    call mkdir(&undodir, "p", 0700)
    set undolevels=1000
    set undoreload=10000
endif

" swap
set swapfile directory=$HOME/.cache/vim/swapfiles//
call mkdir(&directory, "p", 0700)

" use space as leader
let mapleader = " "
let maplocalleader = ","

" use ripgrep instead of grep if available
if executable('rg')
    set grepprg=rg\ --vimgrep\ --smart-case\ --no-heading
    set grepformat=%f:%l:%c:%m
endif

