" regex-based alignment
command! -nargs=? -range Align <line1>,<line2>call AlignSection('<args>')
function! AlignSection(regex) range
    let extra = 1
    let sep = empty(a:regex) ? '=' : a:regex
    let maxpos = 0
    let section = getline(a:firstline, a:lastline)
    for line in section
	let pos = match(line, ' *'.sep)
	if maxpos < pos
	    let maxpos = pos
	endif
    endfor
    call map(section, 'AlignLine(v:val, sep, maxpos, extra)')
    call setline(a:firstline, section)
endfunction

function! AlignLine(line, sep, maxpos, extra)
    let m = matchlist(a:line, '\(.\{-}\) \{-}\('.a:sep.'.*\)')
    if empty(m)
	return a:line
    endif
    let spaces = repeat(' ', a:maxpos - strlen(m[1]) + a:extra)
    return m[1] . spaces . m[2]
endfunction
vnoremap <silent> <leader>a :Align<CR>

" split style
set fillchars+=vert:│

" color scheme
set bg=dark

function! s:set_colors() abort 
    hi Normal ctermbg=NONE
    hi VertSplit ctermbg=NONE    
    hi LspErrorText ctermfg=Red
    hi link LspErrorVirtualText LspErrorText
    hi LspErrorHighlight cterm=undercurl ctermul=Red
    hi LspWarningText ctermfg=Yellow
    hi link LspWarningVirtualText LspWarningText
    hi LspWarningHighlight cterm=undercurl ctermul=Yellow
    hi LspInformationText ctermfg=Blue
    hi link LspInformationVirtualText LspInformationText
    hi LspInformationHighlight cterm=undercurl ctermul=Blue
    hi LspHintText ctermfg=White
    hi link LspHintVirtualText LspHintText
    hi LspHintHighlight cterm=undercurl ctermul=White
endfunction

