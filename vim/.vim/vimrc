function! s:is_git_repo()
    silent! let l:is_git_repo = system('git rev-parse --is-inside-work-tree')
    return trim(l:is_git_repo) ==# 'true'
endfunction

function! FilesOrGitFiles() abort
    let l:cmd = s:is_git_repo() ? 'GFiles' : 'Files'
    execute l:cmd
endfunction
command! FilesOrGitFiles call FilesOrGitFiles()

