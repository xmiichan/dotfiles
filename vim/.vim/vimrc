function! s:on_lsp_buffer_enabled() abort
    setlocal omnifunc=lsp#complete
    setlocal signcolumn=yes
    if exists('+tagfunc') | setlocal tagfunc=lsp#tagfunc | endif
    nmap <buffer> fs <Plug>(lsp-document-symbol-search)
    nmap <buffer> fS <Plug>(lsp-workspace-symbol-search)
    nmap <buffer> gd <Plug>(lsp-definition)
    nmap <buffer> gu <Plug>(lsp-references)
    nmap <buffer> gi <Plug>(lsp-implementation)
    nmap <buffer> gt <Plug>(lsp-type-definition)
    nmap <buffer> <Leader>a <Plug>(lsp-code-action)
    nmap <buffer> <Leader>r <Plug>(lsp-rename)
    nmap <buffer> <Leader>= <Plug>(lsp-document-format)
    nmap <buffer> [d <Plug>(lsp-previous-diagnostic)
    nmap <buffer> ]d <Plug>(lsp-next-diagnostic)
    nmap <buffer> K  <Plug>(lsp-hover)
    inoremap <expr><buffer> <C-d> popup_list()->empty() ? "\<C-d>" : lsp#scroll(+4)
    inoremap <expr><buffer> <C-u> popup_list()->empty() ? "\<C-u>" : lsp#scroll(-4)

    let g:lsp_format_sync_timeout = 1000
endfunction

