#!/bin/sh

{{- if eq .chezmoi.os "darwin" }}
# {{ include "Library/LaunchAgents/com.mii.mail-sync.plist.tmpl" | sha256sum }}
# {{ include "Library/LaunchAgents/com.mii.cal-sync.plist.tmpl" | sha256sum }}
for label in mail-sync cal-sync; do
    launchctl unload "{{ .chezmoi.homeDir }}/Library/LaunchAgents/com.mii.$label.plist" 2>/dev/null
    launchctl load -w "{{ .chezmoi.homeDir }}/Library/LaunchAgents/com.mii.$label.plist"
done
{{- else }}
# {{ include "dot_config/systemd/user/mail-sync.service.tmpl" | sha256sum }}
# {{ include "dot_config/systemd/user/mail-sync.timer" | sha256sum }}
# {{ include "dot_config/systemd/user/cal-sync.service.tmpl" | sha256sum }}
# {{ include "dot_config/systemd/user/cal-sync.timer" | sha256sum }}
systemctl --user daemon-reload
systemctl --user enable --now mail-sync.timer cal-sync.timer
{{- end }}
